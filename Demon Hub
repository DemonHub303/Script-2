-- ============================================================
-- 3. SISTEMA DE DETECÇÃO
-- ============================================================
local KNOWN_ADMINS = {}
local KNOWN_CHEATERS = {}

local function isAdmin(plr)
    if table.find(KNOWN_ADMINS, plr.Name) then return true end
    local lowerName = plr.Name:lower()
    if lowerName:find("admin") or lowerName:find("mod") or lowerName:find("owner") then return true end
    return false
end

local function isCheater(plr)
    if table.find(KNOWN_CHEATERS, plr.Name) then return true end
    local char = plr.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed > 50 then return true end
    end
    return false
end

-- ============================================================
-- 4. LÓGICA DE ESP (BillboardGui - Nativo do Roblox)
-- ============================================================
local ESPStore = {}

local function CreateESP(plr)
    local char = plr.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DemonESP"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false
    billboard.Parent = head

    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(1, 0, 1, 0)
    mainFrame.BackgroundTransparency = 1
    mainFrame.Parent = billboard

    local outline = Instance.new("Frame")
    outline.Name = "Outline"
    outline.Size = UDim2.new(1, -40, 1, -10)
    outline.Position = UDim2.new(0, 20, 0, 5)
    outline.BackgroundTransparency = 1
    outline.BorderSizePixel = 2
    outline.BorderColor3 = Config.colorTheme
    outline.Parent = mainFrame

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.new(1, 0, 0, 15)
    nameLabel.Position = UDim2.new(0, 0, 0, -15)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = plr.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = 12
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Visible = false
    nameLabel.Parent = mainFrame

    local distLabel = Instance.new("TextLabel")
    distLabel.Name = "DistLabel"
    distLabel.Size = UDim2.new(1, 0, 0, 15)
    distLabel.Position = UDim2.new(0, 0, 1, 2)
    distLabel.BackgroundTransparency = 1
    distLabel.TextColor3 = Config.colorTheme
    distLabel.TextSize = 12
    distLabel.Font = Enum.Font.GothamBold
    distLabel.TextStrokeTransparency = 0
    distLabel.Visible = false
    distLabel.Parent = mainFrame

    local healthBar = Instance.new("Frame")
    healthBar.Name = "HealthBar"
    healthBar.Size = UDim2.new(0, 4, 1, -10)
    healthBar.Position = UDim2.new(1, -15, 0, 5)
    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthBar.BorderSizePixel = 0
    healthBar.Visible = false
    healthBar.Parent = mainFrame

    ESPStore[plr] = { Billboard = billboard, Outline = outline, Name = nameLabel, Dist = distLabel, Health = healthBar }
end

local function RemoveESP(plr)
    if ESPStore[plr] then
        if ESPStore[plr].Billboard then
            ESPStore[plr].Billboard:Destroy()
        end
        ESPStore[plr] = nil
    end
end

-- Atualiza a lógica
RunService.RenderStepped:Connect(function()
    if not MainGui.Parent then return end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")
        
        if not char or not hum or hum.Health <= 0 or not head then
            RemoveESP(plr)
            continue
        end
        
        if not ESPStore[plr] or ESPStore[plr].Billboard.Parent ~= head then
            RemoveESP(plr)
            CreateESP(plr)
        end
        
        local data = ESPStore[plr]
        if data then
            local root = char:FindFirstChild("HumanoidRootPart")
            local dist = root and math.floor((LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude) or 0
            
            -- Verifica Admin/Cheater
            local plrIsAdmin = Config.adminESP and isAdmin(plr)
            local plrIsCheater = Config.cheaterESP and isCheater(plr)
            
            local isVisible = Config.nameTagESP or Config.distanceESP or Config.boxESP or Config.healthBarESP or plrIsAdmin or plrIsCheater
            data.Billboard.Enabled = isVisible
            
            if isVisible then
                -- Nome
                data.Name.Visible = Config.nameTagESP or plrIsAdmin or plrIsCheater
                if plrIsAdmin then
                    data.Name.Text = "[ADMIN] " .. plr.Name
                    data.Name.TextColor3 = Config.adminColor
                elseif plrIsCheater then
                    data.Name.Text = "[CHEATER] " .. plr.Name
                    data.Name.TextColor3 = Config.cheaterColor
                else
                    data.Name.Text = plr.Name
                    data.Name.TextColor3 = Color3.fromRGB(255, 255, 255)
                end
                
                -- Distância
                data.Dist.Visible = Config.distanceESP
                data.Dist.Text = "[" .. dist .. "m]"
                
                -- Box e Cor
                data.Outline.Visible = Config.boxESP or plrIsAdmin or plrIsCheater
                if plrIsAdmin then
                    data.Outline.BorderColor3 = Config.adminColor
                elseif plrIsCheater then
                    data.Outline.BorderColor3 = Config.cheaterColor
                else
                    data.Outline.BorderColor3 = Config.colorTheme
                end
                
                -- Vida
                data.Health.Visible = Config.healthBarESP
                local hpPct = hum.Health / hum.MaxHealth
                data.Health.Size = UDim2.new(0, 4, hpPct, 0)
                data.Health.Position = UDim2.new(1, -15, 1 - hpPct, 0)
                data.Health.BackgroundColor3 = Color3.fromRGB(255 * (1 - hpPct), 255 * hpPct, 0)
            end
        end
    end
end)

