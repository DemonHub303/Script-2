-- 4. LÓGICA DO SISTEMA (Aimbot, ESP, Etc.)
-- ============================================================
local function IsVisible(targetPart)
    if not Config.visibleCheck then return true end
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, targetPart.Parent}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local result = workspace:Raycast(origin, direction, rayParams)
    return result == nil
end

-- Aimbot (MouseLock)
local aiming = false
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 and Config.aimbotEnabled then aiming = true end
end)
UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then 
        aiming = false 
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end)

-- ESP Store
local ESPStore = {}

local function CreateESP(plr)
    local char = plr.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DemonESP"; billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0); billboard.AlwaysOnTop = true
    billboard.Enabled = false; billboard.Parent = head

    local mainFrame = Instance.new("Frame"); mainFrame.Size = UDim2.new(1, 0, 1, 0); mainFrame.BackgroundTransparency = 1; mainFrame.Parent = billboard

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"; nameLabel.Size = UDim2.new(1, 0, 0, 15); nameLabel.Position = UDim2.new(0, 0, 0, -15)
    nameLabel.BackgroundTransparency = 1; nameLabel.Text = plr.Name; nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = Config.espTextSize; nameLabel.Font = Enum.Font.GothamBold; nameLabel.TextStrokeTransparency = 0; nameLabel.Visible = false; nameLabel.Parent = mainFrame

    local distLabel = Instance.new("TextLabel")
    distLabel.Name = "DistLabel"; distLabel.Size = UDim2.new(1, 0, 0, 15); distLabel.Position = UDim2.new(0, 0, 1, 2)
    distLabel.BackgroundTransparency = 1; distLabel.TextColor3 = Config.colorTheme; distLabel.TextSize = Config.espTextSize
    distLabel.Font = Enum.Font.GothamBold; distLabel.TextStrokeTransparency = 0; distLabel.Visible = false; distLabel.Parent = mainFrame

    local healthBar = Instance.new("Frame")
    healthBar.Name = "HealthBar"; healthBar.Size = UDim2.new(0, 4, 1, 0); healthBar.Position = UDim2.new(1, 5, 0, 0)
    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0); healthBar.BorderSizePixel = 0; healthBar.Visible = false; healthBar.Parent = mainFrame

    local highlight = Instance.new("Highlight")
    highlight.Name = "DemonBox"; highlight.Adornee = char
    highlight.FillTransparency = 1; highlight.OutlineColor = Config.colorTheme
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = false; highlight.Parent = char

    ESPStore[plr] = { Billboard = billboard, Name = nameLabel, Dist = distLabel, Health = healthBar, Highlight = highlight, Char = char }
end

local function RemoveESP(plr)
    if ESPStore[plr] then
        if ESPStore[plr].Billboard then ESPStore[plr].Billboard:Destroy() end
        if ESPStore[plr].Highlight then ESPStore[plr].Highlight:Destroy() end
        ESPStore[plr] = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not MainGui.Parent then return end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    -- Lógica do Aimbot
    if aiming and Config.aimbotEnabled and myRoot and Camera then
        local closestPlr, closestDist = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
                local head = plr.Character.Head
                local dist = (Camera.CFrame.Position - head.Position).Magnitude
                if dist < Config.aimbotRadius and dist < closestDist and IsVisible(head) then
                    closestDist = dist; closestPlr = head
                end
            end
        end
        if closestPlr then
            local screenPoint = Camera:WorldToViewportPoint(closestPlr.Position)
            if screenPoint.Z > 0 then
                UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
                mousemoverel((screenPoint.X - Camera.ViewportSize.X/2) * (Config.aimbotSmooth / 10), (screenPoint.Y - Camera.ViewportSize.Y/2) * (Config.aimbotSmooth / 10))
            end
        end
    end

    -- Lógica do ESP
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer or (Config.teamCheck and plr.Team == LocalPlayer.Team) then continue end
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        if not char or not hum or hum.Health <= 0 or not head or not root then
            RemoveESP(plr); continue
        end
        
        if not ESPStore[plr] or ESPStore[plr].Char ~= char then
            RemoveESP(plr); CreateESP(plr)
        end
        
        local data = ESPStore[plr]
        if data then
            local dist = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0
            if dist > Config.maxDist then
                data.Highlight.Enabled = false; data.Billboard.Enabled = false
                continue
            end
            
            data.Highlight.Enabled = Config.boxESP
            data.Billboard.Enabled = Config.nameTagESP or Config.distanceESP or Config.healthBarESP
            
            if data.Billboard.Enabled then
                data.Name.Visible = Config.nameTagESP
                data.Name.Text = plr.Name
                data.Dist.Visible = Config.distanceESP
                data.Dist.Text = "[" .. dist .. "m]"
                data.Health.Visible = Config.healthBarESP
                local hpPct = hum.Health / hum.MaxHealth
                data.Health.Size = UDim2.new(0, 4, hpPct, 0)
                data.Health.Position = UDim2.new(1, 5, 1 - hpPct, 0)
                data.Health.BackgroundColor3 = Color3.fromRGB(255 * (1 - hpPct), 255 * hpPct, 0)
            end
        end
    end
end)

