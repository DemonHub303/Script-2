local function CreateCard(parent, titleText, pos, size)
    local frame = Instance.new("Frame")
    frame.Size = size; frame.Position = pos
    frame.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    frame.BorderSizePixel = 0; frame.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = frame
    local s = Instance.new("UIStroke"); s.Color = Config.colorTheme; s.Transparency = 0.8; s.Parent = frame

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 24); lbl.Position = UDim2.new(0, 10, 0, 5)
    lbl.BackgroundTransparency = 1; lbl.Text = titleText
    lbl.TextColor3 = Config.colorTheme; lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = frame

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6); layout.SortOrder = Enum.SortOrder.LayoutOrder; layout.Parent = frame
    
    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 35); pad.PaddingLeft = UDim.new(0, 10); pad.PaddingRight = UDim.new(0, 10)
    pad.Parent = frame
    return frame
end

local function CreateToggle(parent, labelText, initial, order, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 24)
    btn.BackgroundColor3 = Color3.fromRGB(15, 15, 18); btn.BorderSizePixel = 0
    btn.Text = ""; btn.LayoutOrder = order; btn.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = btn

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -50, 1, 0); lbl.Position = UDim2.new(0, 8, 0, 0)
    lbl.BackgroundTransparency = 1; lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(200, 200, 200); lbl.TextSize = 11
    lbl.Font = Enum.Font.Gotham; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = btn

    local sw = Instance.new("Frame")
    sw.Size = UDim2.new(0, 30, 0, 16); sw.Position = UDim2.new(1, -38, 0.5, -8)
    sw.BackgroundColor3 = initial and Config.colorTheme or Color3.fromRGB(50, 50, 50)
    sw.BorderSizePixel = 0; sw.Parent = btn
    local swc = Instance.new("UICorner"); swc.CornerRadius = UDim.new(1, 0); swc.Parent = sw

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.Position = initial and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255); knob.BorderSizePixel = 0; knob.Parent = sw
    local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = knob

    local state = initial
    btn.MouseButton1Click:Connect(function()
        state = not state
        sw.BackgroundColor3 = state and Config.colorTheme or Color3.fromRGB(50, 50, 50)
        knob.Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
        if callback then callback(state) end
    end)
end

local function CreateSlider(parent, labelText, min, max, initial, order, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 32); frame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    frame.BorderSizePixel = 0; frame.LayoutOrder = order; frame.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = frame

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -50, 0, 16); lbl.Position = UDim2.new(0, 8, 0, 2)
    lbl.BackgroundTransparency = 1; lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(200, 200, 200); lbl.TextSize = 10
    lbl.Font = Enum.Font.Gotham; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = frame

    local valBox = Instance.new("TextLabel")
    valBox.Size = UDim2.new(0, 35, 0, 16); valBox.Position = UDim2.new(1, -43, 0, 2)
    valBox.BackgroundColor3 = Color3.fromRGB(30, 30, 30); valBox.Text = tostring(initial)
    valBox.TextColor3 = Color3.fromRGB(255, 255, 255); valBox.TextSize = 10
    valBox.Font = Enum.Font.Gotham; valBox.Parent = frame
    local vc = Instance.new("UICorner"); vc.CornerRadius = UDim.new(0, 3); vc.Parent = valBox

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -16, 0, 6); bar.Position = UDim2.new(0, 8, 1, -10)
    bar.BackgroundColor3 = Color3.fromRGB(40, 40, 40); bar.BorderSizePixel = 0; bar.Parent = frame
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(1, 0); bc.Parent = bar

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((initial - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Config.colorTheme; fill.BorderSizePixel = 0; fill.Parent = bar
    local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(1, 0); fc.Parent = fill

    local dragging = false
    local function update(input)
        local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + (max - min) * rel + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0); valBox.Text = tostring(value)
        if callback then callback(value) end
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; update(input)
        end
    end)
    bar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
end

