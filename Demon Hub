--[[
    Demon Hub - Wrapper Edition
    Controla o Lirp escondido.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 1. CARREGA O LIRP
pcall(function()
    loadstring(game:HttpGet("https://lirp.mrbrainas.workers.dev/Loader", true))()
end)

print("Aguardando o Lirp carregar...")
task.wait(5) -- Espera 5 segundos para o Lirp abrir o menu dele

-- 2. ESCONDE O MENU DO LIRP (Oculta sem deletar para as funções continuarem rodando)
local lirpMenu
for _, gui in pairs(PlayerGui:GetChildren()) do
    if gui:IsA("ScreenGui") and gui.Name ~= "DemonHub" then
        -- Procura a janela principal do Lirp (que geralmente tem o nome Lirp ou tem uma moldura grande)
        if gui.Name:lower():find("lirp") or gui.Name:lower():find("main") then
            gui.Enabled = false
            lirpMenu = gui
        end
    end
end

-- Se não achou pelo nome, tenta esconder a primeira GUI que não é do Roblox
if not lirpMenu then
    for _, gui in pairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "DemonHub" and not gui.Name:lower():find("core") and not gui.Name:lower():find("chat") then
            gui.Enabled = false
            lirpMenu = gui
            break
        end
    end
end

-- 3. CRIA O DEMON HUB (Interface Limpa)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "DemonHub"
ScreenGui.ResetOnSpawn = false
ScreenGui.DisplayOrder = 9999
ScreenGui.Parent = PlayerGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 500, 0, 350)
MainFrame.Position = UDim2.new(0.5, -250, 0.5, -175)
MainFrame.BackgroundColor3 = Color3.fromRGB(12, 10, 12)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local mainCorner = Instance.new("UICorner"); mainCorner.CornerRadius = UDim.new(0, 8); mainCorner.Parent = MainFrame
local mainStroke = Instance.new("UIStroke"); mainStroke.Color = Color3.fromRGB(255, 30, 50); mainStroke.Thickness = 1.5; mainStroke.Parent = MainFrame

local Header = Instance.new("Frame")
Header.Size = UDim2.new(1, 0, 0, 50)
Header.BackgroundColor3 = Color3.fromRGB(20, 10, 12)
Header.Parent = MainFrame
local hc = Instance.new("UICorner"); hc.CornerRadius = UDim.new(0, 8); hc.Parent = Header

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, -60, 1, 0); Title.Position = UDim2.new(0, 20, 0, 0)
Title.BackgroundTransparency = 1; Title.Text = "Demon Hub | PROJECT DELTA"
Title.TextColor3 = Color3.fromRGB(255, 30, 50); Title.TextSize = 18
Title.Font = Enum.Font.GothamBold; Title.TextXAlignment = Enum.TextXAlignment.Left; Title.Parent = Header

local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.new(0, 30, 0, 30); CloseBtn.Position = UDim2.new(1, -45, 0.5, -15)
CloseBtn.BackgroundColor3 = Color3.fromRGB(40, 20, 20); CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.fromRGB(255, 30, 50); CloseBtn.Font = Enum.Font.GothamBold; CloseBtn.Parent = Header
local cbc = Instance.new("UICorner"); cbc.CornerRadius = UDim.new(0, 4); cbc.Parent = CloseBtn
CloseBtn.MouseButton1Click:Connect(function() MainFrame.Visible = false end)

-- Conteúdo
local Content = Instance.new("Frame")
Content.Size = UDim2.new(1, -20, 1, -70); Content.Position = UDim2.new(0, 10, 0, 60)
Content.BackgroundTransparency = 1; Content.Parent = MainFrame
local layout = Instance.new("UIListLayout"); layout.Padding = UDim.new(0, 10); layout.Parent = Content

local info = Instance.new("TextLabel")
info.Size = UDim2.new(1, 0, 0, 40); info.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
info.Text = "O Lirp está rodando em segundo plano!\nUse os botões abaixo para controlar as funções."
info.TextColor3 = Color3.fromRGB(200, 200, 200); info.TextWrapped = true; info.Font = Enum.Font.Gotham; info.TextSize = 12; info.Parent = Content
local ic = Instance.new("UICorner"); ic.CornerRadius = UDim.new(0, 4); ic.Parent = info

-- Botão para abrir o menu escondido do Lirp (caso precise configurar)
local btnShowLirp = Instance.new("TextButton")
btnShowLirp.Size = UDim2.new(1, 0, 0, 40); btnShowLirp.BackgroundColor3 = Color3.fromRGB(255, 30, 50)
btnShowLirp.Text = "Abrir Menu de Configurações (Lirp)"; btnShowLirp.TextColor3 = Color3.fromRGB(255, 255, 255)
btnShowLirp.Font = Enum.Font.GothamBold; btnShowLirp.Parent = Content
local bslc = Instance.new("UICorner"); bslc.CornerRadius = UDim.new(0, 4); bslc.Parent = btnShowLirp

btnShowLirp.MouseButton1Click:Connect(function()
    if lirpMenu then
        lirpMenu.Enabled = not lirpMenu.Enabled
    end
end)

-- Botão Mobile / Floating
local FloatingBtn = Instance.new("TextButton")
FloatingBtn.Size = UDim2.new(0, 50, 0, 50); FloatingBtn.Position = UDim2.new(1, -70, 0.5, -25)
FloatingBtn.BackgroundColor3 = Color3.fromRGB(15, 10, 12); FloatingBtn.Text = "DEMON"
FloatingBtn.TextColor3 = Color3.fromRGB(255, 30, 50); FloatingBtn.Font = Enum.Font.GothamBold
FloatingBtn.TextSize = 10; FloatingBtn.Active = true; FloatingBtn.Draggable = true
FloatingBtn.Parent = ScreenGui
local fbc = Instance.new("UICorner"); fbc.CornerRadius = UDim.new(1, 0); fbc.Parent = FloatingBtn
local fbs = Instance.new("UIStroke"); fbs.Color = Color3.fromRGB(255, 30, 50); fbs.Thickness = 2; fbs.Parent = FloatingBtn
FloatingBtn.MouseButton1Click:Connect(function() MainFrame.Visible = not MainFrame.Visible end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        MainFrame.Visible = not MainFrame.Visible
    end
end)
