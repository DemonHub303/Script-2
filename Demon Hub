-- Botões de Aba
local function CreateTabButton(text, icon, page)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.33, -2, 1, 0); btn.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
    btn.Text = icon .. "  " .. text; btn.TextColor3 = Color3.fromRGB(150, 150, 150)
    btn.Font = Enum.Font.GothamBold; btn.TextSize = 12; btn.Parent = TabBar
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        PageAimbot.Visible = false; PageESP.Visible = false; PageSettings.Visible = false
        for _, b in ipairs(TabBar:GetChildren()) do
            if b:IsA("TextButton") then b.BackgroundColor3 = Color3.fromRGB(20, 20, 22); b.TextColor3 = Color3.fromRGB(150, 150, 150) end
        end
        page.Visible = true; btn.BackgroundColor3 = Color3.fromRGB(255, 30, 50); btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
    return btn
end

